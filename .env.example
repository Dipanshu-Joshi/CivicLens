# CivicSense environment template — COPY to .env and fill locally.
# NEVER commit real values. .env is git-ignored; this file contains placeholders only.
# Load into the current PowerShell session with: .\scripts\dev-env.ps1
# Every value below is process-scoped; no user/machine environment is changed.
# Keys marked "reserved" are retained for provider portability but are not read by
# the current Spring Boot configuration.

# ---- Application ----
CIVICSENSE_APP_VERSION=0.1.0
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- Supabase PostgreSQL (direct connection, port 5432 for Flyway) ----
# Use the DIRECT connection (5432) for Flyway DDL. Never use the transaction
# pooler (6543) for migrations. ddl-auto=validate; Flyway owns the schema.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<supabase-db-password>

# ---- Supabase Storage (S3-compatible API) ----
CIVICSENSE_STORAGE_PROVIDER=supabase-storage
CIVICSENSE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
CIVICSENSE_S3_BUCKET=civic-images
CIVICSENSE_S3_ACCESS_KEY=<storage-access-key>
CIVICSENSE_S3_SECRET_KEY=<storage-secret-key>
CIVICSENSE_S3_REGION=us-east-1
CIVICSENSE_S3_PATH_STYLE=true

# ---- CORS ----
CIVICSENSE_ALLOWED_ORIGINS=http://localhost:5173

# ---- Security headers (Phase 10) ----
# Default permits inline styles only for Vite runtime injection. Use a single
#-quoted source list here; do not add a browser <meta> CSP.
CIVICSENSE_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' http://localhost:8080 https://tile.openstreetmap.org; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# ---- JWT / authentication (Phase 2) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CIVICSENSE_JWT_SECRET=<generate-a-32-byte-minimum-random-secret>
CIVICSENSE_JWT_ACCESS_MINUTES=15
CIVICSENSE_JWT_REFRESH_DAYS=7
# Set to true whenever TLS is used (any non-local deployment).
CIVICSENSE_REFRESH_COOKIE_SECURE=false
# Optional bootstrap on startup; leave blank to create the super admin later.
CIVICSENSE_SUPERADMIN_EMAIL=<superadmin-email-or-blank>
CIVICSENSE_SUPERADMIN_PASSWORD=<superadmin-password-or-blank>

# ---- Password reset (Phase 10) ----
# Raw tokens are never stored or returned by an API; only SHA-256 hashes are
# persisted. Set the reset URL to the deployed SPA route.
CIVICSENSE_RESET_TOKEN_MINUTES=30
CIVICSENSE_RESET_RATE_LIMIT=5
CIVICSENSE_RESET_RATE_WINDOW_MINUTES=15
CIVICSENSE_RESET_URL=http://localhost:5173/reset-password

# ---- Password hashing (Phase 12) ----
# New hashes are Argon2id; existing BCrypt hashes are upgraded after a successful
# login without forcing a password reset. Lower memory only for local tests.
CIVICSENSE_ARGON2_SALT_LENGTH=16
CIVICSENSE_ARGON2_HASH_LENGTH=32
CIVICSENSE_ARGON2_PARALLELISM=1
CIVICSENSE_ARGON2_MEMORY_KB=65536
CIVICSENSE_ARGON2_ITERATIONS=2

# ---- Password-reset email (Phase 12) ----
# Leave CIVICSENSE_MAIL_ENABLED=false unless every SMTP value is supplied.
# Raw reset tokens are sent only in the message body and are never logged.
CIVICSENSE_MAIL_ENABLED=false
CIVICSENSE_MAIL_FROM=<sender-address-or-blank>
CIVICSENSE_MAIL_RESET_SUBJECT=CivicSense password reset
CIVICSENSE_MAIL_HOST=<smtp-host-or-blank>
CIVICSENSE_MAIL_PORT=587
CIVICSENSE_MAIL_USERNAME=<smtp-username-or-blank>
CIVICSENSE_MAIL_PASSWORD=<smtp-password-or-blank>
CIVICSENSE_MAIL_SMTP_AUTH=true
CIVICSENSE_MAIL_STARTTLS=true

# ---- API rate limits (Phase 10; in-memory and single-instance) ----
# A shared store (for example Redis) is a prerequisite for horizontal scale-out.
CIVICSENSE_RATE_GLOBAL_CAPACITY=120
CIVICSENSE_RATE_GLOBAL_WINDOW_MINUTES=1
CIVICSENSE_RATE_SUBMIT_CAPACITY=3
CIVICSENSE_RATE_SUBMIT_WINDOW_MINUTES=1
CIVICSENSE_RATE_PRESIGN_CAPACITY=10
CIVICSENSE_RATE_PRESIGN_WINDOW_MINUTES=1

# ---- Data retention (Phase 10; disabled by default) ----
# Set CIVICSENSE_RETENTION_ENABLED=true and a cron such as "0 0 2 * * *" only
# after a verified backup exists. "-" means the schedule is disabled.
CIVICSENSE_RETENTION_MONTHS=24
CIVICSENSE_RETENTION_ENABLED=false
CIVICSENSE_RETENTION_CRON=-

# ---- AI (Phase 5) ----
CIVICSENSE_AI_PROVIDER=stub
CIVICSENSE_AI_BASE_URL=https://api.openai.com/v1
CIVICSENSE_AI_API_KEY=<ai-api-key-or-leave-placeholder-with-stub>
CIVICSENSE_AI_MODEL=gpt-4o-mini
CIVICSENSE_AI_TIMEOUT_MS=20000
CIVICSENSE_AI_MAX_ATTEMPTS=3
CIVICSENSE_AI_CONFIDENCE_THRESHOLD=0.75
CIVICSENSE_AI_PROMPT_VERSION=civic-v1
CIVICSENSE_AI_MAX_IMAGES=5

# ---- Image uploads (Phase 5) ----
CIVICSENSE_UPLOAD_MAX_BYTES=10485760
CIVICSENSE_UPLOAD_PRESIGN_TTL_SECONDS=900
CIVICSENSE_UPLOAD_VIEW_TTL_SECONDS=300

# ---- Geocoding (Phase 6; reserved provider keys) ----
CIVICSENSE_GEO_PROVIDER=nominatim
CIVICSENSE_GEO_BASE_URL=https://nominatim.openstreetmap.org
CIVICSENSE_GEO_API_KEY=<geocoding-api-key-if-required>
CIVICSENSE_GEO_RATE_LIMIT_RPS=1

# ---- Frontend (Vite, VITE_ prefixed) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_MAP_PROVIDER=osm
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
